{
  "name": "i20 Loopback",
  "model": "TLP725M",
  "size": [1024, 600],

  "_brief": "One test page for experiments/loopback: a button per feedback value of 1bynd_19_20024, which sends that value and lights when the driver's status matches, and a readout per numeric status. Bind in Global Configurator per experiments/loopback/panel/README.md.",

  "theme": {
    "background": "#12131C",
    "surface": "#242634",
    "raised": "#2E3142",
    "accent": "#3D8BFD",
    "text": "#FFFFFF",
    "muted": "#BABCCE",
    "font": "Open Sans",
    "size": 16,
    "on": "accent"
  },

  "pages": [
    {
      "name": "i20 Status",
      "number": 1000,
      "controls": [
        { "kind": "label", "name": "Title", "rect": [16, 4, 700, 44],
          "text": "IV-CAM-I20 loopback", "align": "left", "size": 22 },
        { "kind": "label", "name": "ConnValue", "rect": [724, 4, 284, 44],
          "text": "Connection: --", "align": "right", "size": 16, "color": "muted" },

        { "kind": "label", "name": "PowerLabel", "rect": [16, 56, 150, 60],
          "text": "Power", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [176, 56, 270, 60], "cols": 2, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "PowerOn", "text": "On" },
                       { "name": "PowerOff", "text": "Off" } ] } },
        { "kind": "label", "name": "TrackLabel", "rect": [470, 56, 150, 60],
          "text": "Auto Tracking", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [630, 56, 270, 60], "cols": 2, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "TrackStart", "text": "Start" },
                       { "name": "TrackStop", "text": "Stop" } ] } },

        { "kind": "label", "name": "AELabel", "rect": [16, 128, 150, 60],
          "text": "Auto Exposure", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [176, 128, 832, 60], "cols": 5, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "AEFullAuto", "text": "Full Auto" },
                       { "name": "AEManual", "text": "Manual" },
                       { "name": "AEShutter", "text": "Shutter Pri" },
                       { "name": "AEIris", "text": "Iris Pri" },
                       { "name": "AEBright", "text": "Bright" } ] } },

        { "kind": "label", "name": "WBLabel", "rect": [16, 200, 150, 60],
          "text": "White Balance", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [176, 200, 832, 60], "cols": 6, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "WBAuto", "text": "Auto" },
                       { "name": "WBIndoor", "text": "Indoor" },
                       { "name": "WBOutdoor", "text": "Outdoor" },
                       { "name": "WBOnePush", "text": "One Push" },
                       { "name": "WBManual", "text": "Manual" },
                       { "name": "WBTrigger", "text": "Trigger" } ] } },

        { "kind": "label", "name": "AFLabel", "rect": [16, 272, 150, 60],
          "text": "Auto Focus", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [176, 272, 270, 60], "cols": 2, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "AFOn", "text": "On" },
                       { "name": "AFOff", "text": "Off" } ] } },
        { "kind": "label", "name": "BLLabel", "rect": [470, 272, 150, 60],
          "text": "Backlight", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [630, 272, 270, 60], "cols": 2, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "BLOn", "text": "On" },
                       { "name": "BLOff", "text": "Off" } ] } },

        { "kind": "label", "name": "FFLabel", "rect": [16, 344, 150, 60],
          "text": "Freeze Frame", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [176, 344, 270, 60], "cols": 2, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "FFOn", "text": "On" },
                       { "name": "FFOff", "text": "Off" } ] } },
        { "kind": "label", "name": "OutLabel", "rect": [470, 344, 150, 60],
          "text": "Camera Output", "align": "left", "size": 16, "color": "muted" },
        { "grid": { "rect": [630, 344, 378, 60], "cols": 5, "gap": 13,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [ { "name": "Out1", "text": "1" }, { "name": "Out2", "text": "2" },
                       { "name": "Out3", "text": "3" }, { "name": "Out4", "text": "4" },
                       { "name": "Out5", "text": "5" } ] } },

        { "kind": "panel", "name": "ReadoutWell", "rect": [16, 420, 992, 164],
          "fill": "surface", "border": "afterburn-flat" },
        { "grid": { "rect": [32, 428, 960, 32], "cols": 4, "gap": 16,
            "kind": "label", "align": "left", "size": 14, "color": "muted",
            "items": [ { "name": "ZoomCaption", "text": "Zoom Position" },
                       { "name": "PanCaption", "text": "Pan Angle" },
                       { "name": "TiltCaption", "text": "Tilt Angle" },
                       { "name": "OutCaption", "text": "Camera Output" } ] } },
        { "grid": { "rect": [32, 460, 960, 48], "cols": 4, "gap": 16,
            "kind": "label", "align": "left", "size": 26,
            "items": [ { "name": "ZoomValue", "text": "--" },
                       { "name": "PanValue", "text": "--" },
                       { "name": "TiltValue", "text": "--" },
                       { "name": "OutValue", "text": "--" } ] } },
        { "grid": { "rect": [32, 520, 960, 56], "cols": 4, "gap": 16,
            "kind": "label", "align": "left", "size": 16, "color": "muted",
            "items": [ { "name": "Cam2Value", "text": "Cam 2: --" },
                       { "name": "Cam3Value", "text": "Cam 3: --" },
                       { "name": "Cam4Value", "text": "Cam 4: --" },
                       { "name": "Cam5Value", "text": "Cam 5: --" } ] } }
      ]
    }
  ]
}
